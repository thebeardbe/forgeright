<!DOCTYPE html>
<html lang="en" data-theme="<%= theme.followingSystem ? 'system' : theme.id %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin - forgeright</title>
    <%# `console` for the SAME REASON the other two views load it: this page now carries
        the sticky view switcher and the demo band, and both are styled in that sheet. It
        was the only console page without it, so the nav here rendered unstyled while the
        roadmap's did not - drift in a third place, found by measuring the computed style
        in a browser rather than by reading the markup. %>
    <%- include('partials/theme-head', { pageStyles: ['console'] }) %>
</head>
<body>
<div class="wrap">
    <%# ORDER: the banner band, then the tabs, then the header. The tabs are the only way
        to change page, so they sit above everything that can push them off a phone
        screen, and the banner stays above them because it must not scroll away. %>
    <%- include('partials/demo-banner') %>
    <%- include('partials/console-nav', { activeView: 'console' }) %>
    <header>
        <div>
            <p class="eyebrow">forgeright</p>
            <h1>Admin console</h1>
            <p class="meta"><%= email %> (<%= role %>) &middot; this session runs until <%= expiresAt %></p>
        </div>
        <div class="switchers">
            <%# THE THEME PICKER IS NOT HERE ANY MORE - it moved into the menu bar, which is
                shared by all three console views. Leaving it here too would render two pickers
                and two forms writing the same cookie. The sign-out button stays, because it is
                an action rather than a setting. %>
            <form method="post" action="<%= basePath %>/admin/logout">
                <button type="submit" class="secondary">Sign out</button>
            </form>
        </div>
    </header>

    <div class="card">
        <h2 class="eyebrow">Organisation</h2>
        <form method="post" action="<%= basePath %>/admin/organisation/name" class="row">
            <div>
                <label for="name">Name</label>
                <input type="text" id="name" name="name" value="<%= organisation.name %>" required>
            </div>
            <button type="submit"<%= readOnly ? ' disabled' : '' %>>Save</button>
        </form>
        <p class="meta">Created <%= shortInstant(organisation.created_at) %>. The name starts as a placeholder until it is set here.</p>
    </div>

    <div class="card">
        <h2 class="eyebrow">Invite a participant</h2>
        <form method="post" action="<%= basePath %>/admin/invitations" class="row">
            <div>
                <label for="inv-email">Email address</label>
                <input type="email" id="inv-email" name="email" required placeholder="person@example.com">
            </div>
            <div>
                <label for="inv-dept">Department</label>
                <input type="text" id="inv-dept" name="department" required placeholder="Finance">
            </div>
            <button type="submit"<%= readOnly ? ' disabled' : '' %>>Send invitation</button>
        </form>
    </div>

    <div class="card">
        <h2 class="eyebrow">Invitations</h2>
        <% if (invitations.length === 0) { %>
            <p class="empty">No one has been invited yet.</p>
        <% } else { %>
            <%# THE TABLE SCROLLS INSIDE THE CARD RATHER THAN OVERFLOWING IT.
                Five columns of unbreakable content - an address, a department, two
                timestamps and two buttons - cannot fit a 374px card, and letting the
                table exceed it put the action buttons on the page background, where they
                read as broken layout. A scroll container keeps the CARD as the visible
                boundary and keeps every column reachable; the alternative was dropping
                columns on narrow screens, which hides the controls the page exists for. %>
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr><th>Email</th><th>Department</th><th>Opened</th><th>Links</th><th></th></tr>
                    </thead>
                <tbody>
                <% invitations.forEach(function (inv) { %>
                    <tr>
                        <td><%= inv.email %></td>
                        <td><%= inv.department %></td>
                        <td>
                            <% if (inv.opened_at) { %>
                                <span class="pill yes">opened</span>
                                <div class="meta"><%= shortInstant(inv.opened_at) %></div>
                            <% } else { %>
                                <span class="pill no">not opened</span>
                            <% } %>
                        </td>
                        <td>
                            <%# How many links are live. More than one is normal after
                                Send a link, which adds without retiring. %>
                            <span class="pill <%= inv.live_tokens > 0 ? 'yes' : 'no' %>">
                                <%= inv.live_tokens %> live
                            </span>
                            <% if (inv.token_issued_at) { %>
                                <div class="meta">newest <%= shortInstant(inv.token_issued_at) %></div>
                            <% } %>
                        </td>
                        <td>
                            <div class="actions">
                                <form class="inline" method="post" action="<%= basePath %>/admin/invitations/<%= inv.id %>/send">
                                    <button type="submit"<%= readOnly ? ' disabled' : '' %> class="secondary">Send a link</button>
                                </form>
                                <form class="inline" method="post" action="<%= basePath %>/admin/invitations/<%= inv.id %>/reset">
                                    <button type="submit"<%= readOnly ? ' disabled' : '' %> class="secondary">Reset all access</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
            </div>
            <p class="meta">
                <strong>Send a link</strong> adds a working link and leaves the others working: for a
                participant who missed the first email. <strong>Reset all access</strong> stops every
                link for that person and sends one new one: for a link that may have been shared.
                Both keep every answer already given.
            </p>
        <% } %>
    </div>

    <div class="card">
        <h2 class="eyebrow">Users</h2>
        <form method="post" action="<%= basePath %>/admin/users" class="row">
            <div>
                <label for="user-email">Add by email address</label>
                <input type="email" id="user-email" name="email" required placeholder="colleague@example.com">
            </div>
            <div>
                <label for="user-role">Role</label>
                <select id="user-role" name="role">
                    <option value="user">User</option>
                    <option value="admin">Admin</option>
                </select>
            </div>
            <button type="submit"<%= readOnly ? ' disabled' : '' %>>Add</button>
        </form>

        <%# NOT WRAPPED IN `.table-scroll`, and that is measured rather than forgotten: its
            three columns are an address, a role and a button, which fit the card at every
            width down to 360px (296px of content in a 328px card). A scroll container here
            would be a wrapper nothing needs.

            THE INLINE `margin-top` IS GONE. It was the last `style=` attribute in the views,
            moved into console.css as `.users-table` - this project removed these once and one
            survived, so a rule belongs in the stylesheet rather than on the element. %>
        <table class="users-table">
            <thead>
                <tr><th>Email</th><th>Role</th><th></th></tr>
            </thead>
            <tbody>
            <% users.forEach(function (u) { %>
                <tr>
                    <td><%= u.email %><% if (u.email === email) { %> <span class="meta">(you)</span><% } %></td>
                    <td><%= u.role %></td>
                    <td>
                        <form class="inline" method="post" action="<%= basePath %>/admin/users/<%= u.id %>/role">
                            <input type="hidden" name="role" value="<%= u.role === 'admin' ? 'user' : 'admin' %>">
                            <button type="submit"<%= readOnly ? ' disabled' : '' %> class="secondary">
                                <%= u.role === 'admin' ? 'Demote to user' : 'Promote to admin' %>
                            </button>
                        </form>
                    </td>
                </tr>
            <% }); %>
            </tbody>
        </table>
        <p class="meta">
            A user with the <strong>user</strong> role can sign in but does not see this console. Adding
            someone before they sign in prepares their access. An admin is not told which questionnaire
            answers came from them: the console never shows who said what.
        </p>
    </div>
</div>
</body>
</html>
