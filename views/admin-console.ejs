<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin - forgeright</title>
    <style>
        :root {
            --ink: #14181f;
            --muted: #6b7280;
            --line: #e5e7eb;
            --accent: #1f6feb;
            --bg: #f7f8fa;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg); color: var(--ink); line-height: 1.55;
        }
        .wrap { max-width: 620px; margin: 0 auto; padding: 24px 16px 64px; }
        header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
        .eyebrow {
            font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.14em; color: var(--accent); margin: 0 0 4px;
        }
        h1 { font-size: 1.5rem; margin: 0 0 6px; }
        .card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 18px; margin-bottom: 16px; }
        .card h2 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); margin: 0 0 10px; }
        .who { font-size: 1.05rem; font-weight: 600; margin: 0 0 4px; }
        .meta { color: var(--muted); font-size: 0.85rem; margin: 0; }
        button {
            padding: 10px 16px; font-size: 0.88rem; font-weight: 700; border: 1px solid var(--line);
            border-radius: 8px; background: #fff; color: var(--ink); cursor: pointer; font-family: inherit;
        }
        button:hover { filter: brightness(0.98); }
        .todo { color: var(--muted); font-size: 0.88rem; margin: 0; }
    </style>
</head>
<body>
<div class="wrap">
    <header>
        <div>
            <p class="eyebrow">forgeright</p>
            <h1>Admin console</h1>
        </div>
        <form method="post" action="<%= basePath %>/admin/logout">
            <button type="submit">Sign out</button>
        </form>
    </header>

    <div class="card" style="margin-top:18px;">
        <h2>Signed in</h2>
        <p class="who"><%= email %></p>
        <p class="meta">This session runs until <%= expiresAt %>.</p>
    </div>

    <div class="card">
        <h2>Organisations</h2>
        <p class="todo">The console that lists organisations and their questionnaire progress is the next step. This page exists so that signing in has somewhere to land.</p>
    </div>
</div>
</body>
</html>
