<%#
    The participant's own fields, rendered once for both views.

    SHARED SO THE TWO VIEWS CANNOT DRIFT: a field added here appears everywhere it
    is shown, and the escaping rule is written once. EVERY VALUE GOES THROUGH AN
    ESCAPING TAG, the one that prints with a percent-and-equals. The text came from a
    participant or a model, so it must never be inserted as markup.

    EMPTY AND ABSENT ARE DIFFERENT, and shown differently: a field the participant did
    not give is omitted rather than rendered blank, so a reader can tell "they said
    nothing about this" from "they said nothing".

    THIS COMMENT USED TO BE WRITTEN AS A BLOCK WITH A NESTED TAG IN IT, and that tag
    terminated the comment where it appeared. Everything after it became live template
    output, so the second half of this very paragraph rendered to the page - the
    paragraph explaining that participant text must not be inserted as markup. A
    comment must not contain a delimiter of its own LANGUAGE, which is why this one
    says "the tag that prints with a percent-and-equals" instead of writing it.
%>
<%
    const FIELDS = [
        { key: 'task', label: 'The work' },
        { key: 'trigger', label: 'What starts it' },
        { key: 'frequencyPerWeek', label: 'Times per week' },
        { key: 'timePerPeriod', label: 'Time per period' },
        { key: 'peopleAffected', label: 'People involved' },
        { key: 'handoffTo', label: 'Handed to' },
        { key: 'waitsFor', label: 'Waits for' },
        { key: 'dependsOn', label: 'Depends on' },
        { key: 'systems', label: 'Systems' },
        { key: 'touchedDepartments', label: 'Departments' },
        { key: 'mistakesPerPeriod', label: 'Mistakes' },
        { key: 'mistakeConsequence', label: 'What a mistake costs' },
        { key: 'currentState', label: 'How it is done today' },
        { key: 'frustration', label: 'The worst part' }
    ];

    // A list renders as commas, a period as "6 hours per week", a number plainly.
    // One formatter, so the same field reads the same way in both views.
    // A PROSE ANSWER RETURNS THE PARTICIPANT'S WORDS AND NOTHING ELSE. The marker is
    // rendered by the caller, which is the only place that can put it in the HTML, so this
    // stays a plain text formatter and a value cannot smuggle markup in beside it.
    function show(value) {
        if (isProse(value)) return value.said;
        if (Array.isArray(value)) return value.join(', ');
        if (value && typeof value === 'object' && value.hours !== undefined) {
            return value.hours + ' hours per ' + (value.period || 'period');
        }
        return String(value);
    }

    // The same test the store and the weighing use, restated because a view cannot import a
    // module: an object carrying a non-empty `said` string is the prose marker. Anything
    // else falls through to the ordinary rendering.
    function isProse(value) {
        return Boolean(value) && typeof value === 'object' && !Array.isArray(value)
            && typeof value.said === 'string' && value.said.trim() !== '';
    }
%>
<% if (!data) { %>
    <p class="empty">This answer has no stored fields.</p>
<% } else { %>
    <% FIELDS.filter(function (field) { return data[field.key] !== undefined && data[field.key] !== null; })
             .forEach(function (field) { %>
        <p class="words">
            <strong><%= field.label %>:</strong>
            <%= show(data[field.key]) %>
            <% if (isProse(data[field.key])) { %>
                <span class="tag" title="The participant answered in words. This is their answer, kept verbatim; it was not a figure or a list.">in their own words</span>
            <% } %>
        </p>
    <% }); %>

    <% /* The steps, with the reasoning flag marked: the flag IS the automation boundary,
        so it is shown rather than left in the data. */ %>
    <% /* OMITTED when the caller passes includeSteps false: the roadmap renders the
        process's merged steps above, and showing them again under every answer would
        repeat the same sequence once per participant. */ %>
    <% if ((typeof includeSteps === 'undefined' || includeSteps) && Array.isArray(data.steps) && data.steps.length > 0) { %>
        <h3>Steps</h3>
        <% data.steps.forEach(function (step) { %>
            <div class="step<%= step.needsReasoning ? ' reasoning' : '' %>">
                <div class="step-name">
                    <%= step.name || 'A step' %>
                    <% if (step.needsReasoning) { %><span class="tag reasoning">needs reasoning</span><% } %>
                </div>
                <% if (step.whatHappens) { %><p class="step-what"><%= step.whatHappens %></p><% } %>
                <% if (step.decidedHow) { %>
                    <p class="step-basis"><span class="why">on what basis:</span> <%= step.decidedHow %></p>
                <% } %>
                <%# THE EVIDENCE FOR THE FLAG, beside it. Nothing in the code reads
                    decidedHow, so this quotation is the only way a reader can check
                    that the flag was derived from the basis rather than assumed. The
                    absence is stated rather than left blank, because a model that did
                    not quote is different from one whose quotation was empty. %>
                <% if (step.reasoningBasis) { %>
                    <p class="step-quote"><span class="why">decided by:</span> &ldquo;<%= step.reasoningBasis %>&rdquo;</p>
                <% } else { %>
                    <p class="step-quote missing"><span class="why">decided by:</span> no phrase was quoted</p>
                <% } %>
            </div>
        <% }); %>
    <% } %>
<% } %>
