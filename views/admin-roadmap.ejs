<!DOCTYPE html>
<html lang="en" data-theme="<%= theme.followingSystem ? 'system' : theme.id %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Roadmap - forgeright</title>
    <%- include('partials/theme-head', { pageStyles: ['console'] }) %>
</head>
<body>
<div class="wrap">
    <%- include('partials/demo-banner') %>
    <header>
        <div>
            <p class="eyebrow">forgeright</p>
            <h1><%= organisation.name %></h1>
        </div>
        <div class="switchers">
            <%# THE THEME PICKER IS NOT HERE ANY MORE - it moved into the menu bar, which is
                shared by all three console views. Leaving it here too would render two pickers
                and two forms writing the same cookie. The sign-out button stays, because it is
                an action rather than a setting. %>
            <form method="post" action="<%= basePath %>/admin/logout">
                <button type="submit" class="secondary">Sign out</button>
            </form>
        </div>
    </header>

    <%- include('partials/console-nav', { activeView: 'roadmap' }) %>

    <%- include('partials/console-notice', { subject: 'The process' }) %>

    <p class="intro">
        Every process, highest score first, because early results compound. Open one to
        see its steps with the reasoning marked, the paragraph explaining the score, and
        the answers behind it. A process that was grouped badly sits lower down, and can
        be rejudged where you find it.
    </p>

    <% if (processes.length === 0) { %>
        <div class="card"><p class="empty">No processes have been identified yet.</p></div>
    <% } %>

    <% processes.forEach(function (process) { %>
        <%
            // THE MERGING AND THE COUNTING LIVE IN A MODULE, not here.
            // `mergeProcessSteps` is pure and unit-tested, which the inline version
            // could never be: a rule about where a person stays in the loop was
            // reachable only by rendering a page and reading it. The view renders
            // what it returns and decides nothing.
            const responses = (process.grouping && process.grouping.responses) || [];
            const merged = mergeProcessSteps(responses);
            const steps = merged.steps;
            const describedBy = merged.describedBy;
            const reasoningSteps = merged.reasoningSteps;
        %>
        <details class="item">
            <summary>
                <span class="summary-main">
                    <strong><%= process.name %></strong>
                    <div class="meta">
                        <%# AN EMPTY PROCESS IS A REAL STATE, NOT BROKEN DATA: it is what a
                            process becomes when the only person behind it was regrouped
                            elsewhere. "described by 0 people" on its own reads as a fault,
                            so the state explains itself. The process is kept rather than
                            deleted because an admin's rejudge should not destroy a process
                            they might still be discussing. %>
                        <% if (responses.length === 0) { %>
                            <span class="tag">nothing behind it now</span>
                        <% } else { %>
                        described by <%= responses.length %> <%= responses.length === 1 ? 'person' : 'people' %>
                        <% } %>
                        <% if (describedBy.length > 0) { %>
                            &middot; <%= describedBy.map(function (pair) { return pair[0] + ' ' + pair[1]; }).join(', ') %>
                        <% } %>
                        <% if (reasoningSteps > 0) { %>
                            &middot; <span class="tag reasoning"><%= reasoningSteps %> <%= reasoningSteps === 1 ? 'step needs' : 'steps need' %> a person</span>
                        <% } else if (steps.length > 0) { %>
                            &middot; <span class="tag">no step needs a person</span>
                        <% } %>
                        <%# SPLIT WHILE UNSURE, in the same tag row as everything else. NOT a
                            banner and not counted anywhere: this fires on every
                            low-confidence creation and most are false alarms, so it says
                            what happened and lets a reader decide. The why is the model's
                            own reasoning, already rendered below, so nothing is restated
                            here. A rejudge clears it, because the revision it writes is
                            admin-decided. %>
                        <% if (process.needsReview) { %>
                            &middot; <span class="tag review" title="<%= process.needsReviewReason %>">split while unsure</span>
                        <% } %>
                    </div>
                </span>
                <span class="summary-side">
                    <% if (process.score) { %>
                        <div class="weight"><%= process.score.value %></div>
                        <div class="weight-label">weight</div>
                    <% } else { %>
                        <span class="tag">not weighed</span>
                    <% } %>
                </span>
            </summary>

            <div class="detail">
                <h3>The steps, in order</h3>
                <%# WHERE TWO ACCOUNTS DISAGREE ABOUT A STEP, the row below shows the
                    pessimistic flag and ONE account's quotation, which may be from the
                    account that read the step the other way. That is a known trade, not
                    an accident: showing the quotation from the account that decided the
                    flag would present a rejected reading as the accepted evidence. The
                    other accounts' own flags and quotations are on the Every answer
                    view, under each answer, where the disagreement reads as one.
                    SHOWN ONLY ON AN ACTUAL DISAGREEMENT, from the merge, rather than on
                    every process with several accounts: a note that appears everywhere
                    reads as boilerplate and stops signalling which process needs a look,
                    which is the only reason to show it. %>
                <% if (merged.disagreed) { %>
                    <p class="meta">
                        Described by <%= responses.length %> people, who did not all read
                        <%= merged.disputedSteps === 1 ? 'one step' : merged.disputedSteps + ' steps' %>
                        the same way: where they disagreed, the step is marked as needing a
                        person and its quote comes from one account. Each account's own
                        reading is on <a href="<%= basePath %>/admin/answers">Every answer</a>.
                    </p>
                <% } %>
                <% if (steps.length === 0) { %>
                    <p class="empty">No steps were recorded for this process.</p>
                <% } %>
                <% steps.forEach(function (step) { %>
                    <div class="step<%= step.needsReasoning ? ' reasoning' : '' %>">
                        <div class="step-name">
                            <%= step.name || 'A step' %>
                            <% if (step.needsReasoning) { %><span class="tag reasoning">needs reasoning</span><% } %>
                        </div>
                        <% if (step.whatHappens) { %><p class="step-what"><%= step.whatHappens %></p><% } %>
                        <% if (step.decidedHow) { %>
                            <p class="step-basis"><span class="why">on what basis:</span> <%= step.decidedHow %></p>
                        <% } %>
                        <%# The phrase that decided the flag, so a misread step is
                            visible rather than hidden behind a tidy boolean. %>
                        <% if (step.reasoningBasis) { %>
                            <p class="step-quote"><span class="why">decided by:</span> &ldquo;<%= step.reasoningBasis %>&rdquo;</p>
                        <% } else { %>
                            <p class="step-quote missing"><span class="why">decided by:</span> no phrase was quoted</p>
                        <% } %>
                    </div>
                <% }); %>

                <h3>Departments, and how many described it</h3>
                <ul class="depts">
                    <% describedBy.forEach(function (pair) { %>
                        <li><%= pair[0] %> <%= pair[1] %></li>
                    <% }); %>
                </ul>
                <p class="meta">
                    This counts the people who described the process, not the teams the work
                    crosses. Response rate is a fact about the invitations, and lives on the
                    console page.
                </p>

                <% if (process.score) { %>
                    <h3>Why it got this weight</h3>
                    <p class="paragraph"><%= process.score.reasoning %></p>

                    <h3>The terms behind it</h3>
                    <% /* Cost terms are marked, because a reader must not have to remember
                        which way each one points: high is worse for four of the ten. */ %>
                    <dl class="terms">
                        <% Object.entries(process.score.terms).forEach(function (pair) { %>
                            <div class="term<%= isCostTerm(pair[0]) ? ' cost' : '' %>">
                                <dt><%= pair[0] %><%= isCostTerm(pair[0]) ? ' (high is worse)' : '' %></dt>
                                <dd><%= pair[1] %></dd>
                            </div>
                        <% }); %>
                    </dl>
                <% } else { %>
                    <h3>Why it has no weight</h3>
                    <p class="empty">This process has not been weighed, so it has no number. It sorts last rather than disappearing.</p>
                <% } %>

                <h3>Read together because</h3>
                <% if (process.grouping) { %>
                    <p class="paragraph"><%= process.grouping.reasoning %></p>
                    <p class="meta">
                        <%= process.grouping.confidence %> confidence
                        &middot; <%= process.grouping.decidedBy %>
                        &middot; <%= shortInstant(process.grouping.decided_at) %>
                    </p>
                <% } else { %>
                    <p class="empty">This process has no current grouping.</p>
                <% } %>

                <%#
                    THE ANSWERS BEHIND IT, AS LINKS RATHER THAN AS COPIES.

                    IT USED TO RENDER EVERY PARTICIPANT FIELD INLINE - seven `words` rows per
                    response, each one repeating what the answers view already holds. On a
                    process with three participants that is twenty-one rows of `The work:`,
                    `What starts it:` and so on, and the owner's words were that a link is
                    clearer: "I prefer a link to the specific answer instead of a long list of
                    what the participant answered. it is clearer to see what was answered."

                    WHAT A READER STILL SEES, which is the thing the link must not lose: the
                    DEPARTMENT, and what that answer CONTRIBUTED to this process. Those are the
                    two facts that belong to the GROUPING rather than to the answer - everything
                    else is a click away and identical when they get there. So a reader can still
                    tell who is behind the process and what each of them settled, which is what
                    this section is for.

                    BOTH THE ID AND THE PARAMETER, so the link opens and scrolls. See the note on
                    the `<details>` in admin-answers.ejs: the fragment scrolls, the parameter
                    opens, and they are built from one value so they cannot disagree.
                %>
                <h3>The answers behind it</h3>
                <% if (responses.length === 0) { %>
                    <p class="empty">
                        Everyone who described this process has since been regrouped
                        elsewhere, so nobody is behind it now. Nothing was deleted: the
                        process is kept in case the regrouping is reversed. Rejudging it
                        again will re-identify from its remaining answers, and there are
                        none, so it will stay as it is until something joins it.
                    </p>
                <% } %>
                <ul class="answer-links">
                    <% responses.forEach(function (response) { %>
                        <li>
                            <a href="<%= basePath %>/admin/answers?open=<%= encodeURIComponent(response.responseId) %>#response-<%= encodeURIComponent(response.responseId) %>">
                                <%= response.department %>
                            </a>
                            <span class="meta">contributed: <%= (response.contributed || []).join(', ') || 'not recorded' %></span>
                        </li>
                    <% }); %>
                </ul>

                <h3>Earlier versions</h3>
                <div class="history">
                    <%# REVISIONS, NOT ONLY THE CURRENT ONE. A rejudge groups again, which
                        makes a new revision and restarts the weighing count at 1, so
                        "weighing 1" appears twice over the life of a process. The
                        grouping revision is shown beside it for that reason: it is what
                        tells the earlier score from the new one. %>
                    <% (process.scoreHistory || []).forEach(function (score, index) { %>
                        <%
                            // Only the newest reading of the CURRENT grouping is the
                            // number at the top of this page. Everything else is history,
                            // including a score on an older revision.
                            const isCurrentScore = index === 0
                                && process.score
                                && score.score === process.score.value
                                && score.created_at === process.score.weighed_at;
                        %>
                        <div class="revision<%= isCurrentScore ? ' current' : '' %>">
                            <strong>weighing <%= score.revision_no %></strong>
                            of grouping <%= score.grouping_revision %>
                            <%= isCurrentScore ? '(current)' : '(earlier)' %>
                            <span class="when"><%= shortInstant(score.created_at) %></span>
                            <p class="meta">scored <%= score.score %></p>
                            <p class="meta"><%= score.reasoning %></p>
                        </div>
                    <% }); %>
                    <% if (!process.scoreHistory || process.scoreHistory.length === 0) { %>
                        <p class="empty">This process has never been weighed.</p>
                    <% } %>
                </div>

                <% /* The second entry point. The same mechanism as the one on an answer. */ %>
                <form class="rejudge" method="post" action="<%= basePath %>/admin/roadmap/<%= process.id %>/rejudge">
                    <label for="reason-<%= process.id %>">This flow is wrong</label>
                    <textarea id="reason-<%= process.id %>" name="reason" required
                              placeholder="Say why the grouping looks wrong. The tool re-identifies with your reasoning, then weighs the result again."></textarea>
                    <button type="submit"<%= readOnly ? ' disabled' : '' %> class="secondary">Rejudge this process</button>
                </form>
            </div>
        </details>
    <% }); %>
</div>
</body>
</html>
