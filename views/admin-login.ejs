<!DOCTYPE html>
<html lang="en" data-theme="<%= theme.followingSystem ? 'system' : theme.id %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in - forgeright</title>
    <%- include('partials/theme-head') %>
</head>
<body>
<div class="wrap narrow">
    <header>
        <div>
            <p class="eyebrow">forgeright</p>
            <h1>Admin sign in</h1>
        </div>
        <div class="switchers">
            <%- include('partials/theme-picker') %>
        </div>
    </header>
    <p class="intro">Enter your email address and we will send you a link. There is no password, and a new address creates a new organisation.</p>

    <div class="card">
        <% if (sent) { %>
            <div class="notice">If that address can sign in, a link is on its way. It works once and expires in <%= ttlMinutes %> minutes.</div>
        <% } %>
        <% if (error === 'invalid_email') { %>
            <div class="problem">That does not look like an email address. Check it and try again.</div>
        <% } %>
        <% if (error === 'link_invalid') { %>
            <div class="problem">That sign-in link is not usable. It may have been used already, or it may have expired. Request a new one below.</div>
        <% } %>
        <% if (error === 'send_failed') { %>
            <div class="problem">The sign-in link could not be sent. This is a problem on our side; please try again shortly.</div>
        <% } %>
        <% if (error === 'signin_failed') { %>
            <div class="problem">Signing you in failed. This is a problem on our side; please try again shortly.</div>
        <% } %>
        <% if (error === 'too_many_requests') { %>
            <div class="problem">Too many sign-in requests. Wait a few minutes, then try again.</div>
        <% } %>
        <% if (noConsole) { %>
            <div class="problem">You are signed in, but this account has the <strong>user</strong> role and does not see the admin console. An admin in your organisation can change that.</div>
        <% } %>

        <form method="post" action="<%= basePath %>/admin">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" required autocomplete="email"
                   placeholder="you@example.com" autofocus>
            <button type="submit">Send sign-in link</button>
        </form>
        <p class="note">The link opens once and expires after <%= ttlMinutes %> minutes.</p>
        <p class="note">Questionnaire participant? <a href="<%= basePath %>/lost-link">Get a new questionnaire link</a>.</p>
    </div>
</div>

<!--
    The cookies this site stores, said plainly. TWO now: the session cookie, which
    is essential, and the theme cookie, which remembers an appearance choice. Both
    are named, because a banner that says "one cookie" while setting two is not
    telling the truth.

    Declining is not offered, because neither cookie is optional: the session one
    keeps you signed in, and the theme one is the only way a stored choice can be
    applied before the page paints. There is no analytics and no advertising.
-->
<div id="cookie-banner" class="cookie-banner hidden">
    <div class="cookie-inner">
        <strong>This site stores two cookies.</strong>
        One keeps you signed in to the admin console, and one remembers your theme choice.
        Both are essential to how the site works, so they are set either way. There are no
        analytics and no advertising cookies.
        <div class="cookie-actions">
            <button id="cookie-ok">Understood</button>
        </div>
    </div>
</div>

<script>
    // The banner records only that it was seen, in localStorage rather than a
    // cookie, so acknowledging it does not itself set one. Sign-in does not depend
    // on this running: the banner is hidden until the script shows it.
    (function () {
        var banner = document.getElementById('cookie-banner');
        try {
            if (!localStorage.getItem('fr_cookie_notice')) banner.classList.remove('hidden');
        } catch (err) {
            // localStorage can be unavailable (private mode, disabled storage). The
            // safe degradation is to show the notice, not to hide it.
            banner.classList.remove('hidden');
        }
        document.getElementById('cookie-ok').addEventListener('click', function () {
            try { localStorage.setItem('fr_cookie_notice', '1'); } catch (err) { /* storage unavailable */ }
            banner.classList.add('hidden');
        });
    })();
</script>
</body>
</html>
