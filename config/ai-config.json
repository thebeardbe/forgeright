      "defaultModel": "gemini-2.5-flash",
      "fallbackModels": ["gemini-3.1-flash-lite-preview"]
    },
    "deepseek": {
      "active": true,
      "type": "openai-compatible",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "baseUrl": "https://api.deepseek.com",
      "apiVersion": "v1",
      "defaultModel": "deepseek-chat",
      "fallbackModels": []
    }
  }
}
