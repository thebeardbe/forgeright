# Copy to .env and fill in. .env is gitignored, never commit it.

# Which AI provider to use. One of: mock | gemini | deepseek
# "mock" needs no key and is the default for local development.
AI_PROVIDER=mock

# Hosts this instance answers on, as a comma-separated list. Compare is on the
# hostname only (the port is stripped), case-insensitively, and empty entries
# are ignored, so a trailing comma is harmless.
#
# The intended deployment sets the subdomain; the local development entry lets
# the same .env serve both:
#   ALLOWED_HOST=localhost,127.0.0.1,forgeright.bunkens.be
#
# When the app is reached over Tailscale, the machine's own MagicDNS name must be
# listed too, because the browser sends that as the Host header:
#   ALLOWED_HOST=localhost,127.0.0.1,pi-agents.tail399956.ts.net,forgeright.bunkens.be
#
# Leave empty to accept any host (development only).
# IPv6 literals are not supported here and are refused.
ALLOWED_HOST=

# Port the server listens on. The proxy terminates the subdomain and forwards here.
PORT=3000

# Interface the listener binds. Defaults to 127.0.0.1, so the app is reachable only
# from this host. That is the other half of the proxy-trust boundary: TRUST_PROXY
# decides which PEER may claim a request was HTTPS, and HOST decides who can
# connect at all. Set HOST=0.0.0.0 only when something off-host must connect
# (a proxy on another machine, a private network), and then set TRUST_PROXY to
# that proxy's address.
HOST=127.0.0.1

# Which peers may be trusted to send X-Forwarded-Proto, and therefore to decide
# whether a request counts as secure. The whole site refuses a plain-HTTP request,
# so this setting decides whether anything is served at all behind a proxy.
#
# AN ADDRESS, NOT A HOP COUNT. A hop count says "trust whoever connects to me",
# which a LAN client satisfies just as easily as a proxy: it only has to send the
# header. An address says "trust this peer", which a client cannot claim.
#
#   (unset)        trust nothing. Correct when nothing is in front.
#   127.0.0.1      trust a proxy on this host. THE DEPLOYMENT SETTING, with HOST
#                  at its default of 127.0.0.1 so nothing else can reach the port.
#   loopback       alias for 127.0.0.1 and ::1.
#   10.0.0.1,10.0.0.2
#                  a list, for a proxy that may appear from more than one address.
#   1              a hop count. Kept because Express supports it, but ONLY safe
#                  when the port is unreachable except through the proxy, because
#                  it cannot tell a proxy from a client. The server warns when
#                  this form is used.
#
# `true` is refused: it trusts every client.
TRUST_PROXY=127.0.0.1

# Shared secret gating the questionnaire. Participants enter it to start.
# Generate with: openssl rand -hex 16
AUDIT_ACCESS_CODE=change-me

# --- Admin sign-in ---

# Signs the admin session cookie. REQUIRED: the server refuses to start without
# it, because a secret generated per process would invalidate every session on
# restart and look like a broken login rather than a missing setting.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL for this installation: the absolute address it is reached at.
# Used to build mailed sign-in links AND to redirect a plain-HTTP request to its
# HTTPS address.
#
# Must be set for anything but local development: a URL built from a request
# header would let a forged Host decide where a link or a redirect points. Include
# the base path when there is one. No trailing slash.
# Local:    http://localhost:3000
# Deployed: https://forgeright.bunkens.be
#
# Use https:// here in any deployment. A plain-http value still works over
# localhost, but a remote plain-HTTP request is refused with an explanation rather
# than a redirect, because there is no secure address to send it to.
PUBLIC_BASE_URL=

# Path this app is MOUNTED at: the prefix an incoming request carries, which
# Express strips before the routes run. Empty means the app expects requests at
# the root.
#
# THERE ARE TWO PREFIXES, and a reverse proxy can separate them. The prefix a
# request arrives with may differ from the prefix the browser uses. The second is
# the PUBLIC path: it is derived from the path in PUBLIC_BASE_URL, so it needs no
# variable of its own. All three modes:
#
#   proxy passes the prefix through   BASE_PATH=/forgeright   PUBLIC_BASE_URL=https://host/forgeright
#   proxy STRIPS the prefix           BASE_PATH=               PUBLIC_BASE_URL=https://host/forgeright
#   no prefix at all                  BASE_PATH=               PUBLIC_BASE_URL=https://host
#
# The middle one is `tailscale serve --set-path /forgeright`: it strips
# /forgeright before forwarding, so the app must expect the root while its
# emitted URLs still carry /forgeright. Setting BASE_PATH=/forgeright there
# produces a 404, because the app waits for a prefix it is never sent.
#
# Accepts "forgeright" or "/forgeright"; a trailing slash is ignored. Anything
# that is not a single safe path (a ".." segment, a space, a query or fragment)
# stops the server at startup rather than producing broken URLs.
BASE_PATH=

# OPTIONAL override for the public path, which is otherwise derived from
# PUBLIC_BASE_URL. Set it only when the emitted prefix must differ from that
# URL's path; it is validated and cross-checked against the derived value, and
# startup fails if the two disagree. Leave it empty normally.
PUBLIC_PATH=

# How long a sign-in link stays valid, in minutes. Default 15. Empty counts as
# unset. A link is single-use regardless of this value.
LOGIN_LINK_TTL_MINUTES=

# How long an admin session lasts, in hours. Default 12, which covers a working
# day and ends before the next morning. Empty counts as unset.
SESSION_TTL_HOURS=

# --- Mail ---

# How sign-in links are delivered. One of: console | proton
#   console (default) prints the message to stdout. Needs no credentials, and is
#           how local development works without a mail account.
#   proton  sends through proton-cli on this machine, using the profile below.
#
# With proton: "jobsearch" sends from beard_jobagent@proton.me, a disposable
# mailbox for testing. Production sends from a bunkens.be address, so the profile
# changes there, along with the address it sends as.
MAIL_SENDER=console

# The proton-cli profile to send from, when MAIL_SENDER=proton. A profile with an
# expired session makes the send fail loudly, naming the exit code and the
# command to re-authenticate: proton-cli account login --profile <name>
MAIL_PROTON_PROFILE=jobsearch

# --- Storage ---

# Directory holding one SQLite file per organisation, under <STORE_DIR>/orgs/.
# Defaults to data/store when unset. Point this at a mounted volume in
# production, so the store survives a container rebuild.
STORE_DIR=

# How long a connection waits for another writer's lock, in milliseconds.
# Defaults to 2000 when unset or empty. WAL allows one writer at a time and does
# not queue them, so this is what stops a second participant submitting at the
# same moment from getting a "database is locked" error. Values above 60000 are
# clamped to 60000 with a warning. Leave it empty to take the default; do not set
# it to 0, which disables waiting.
STORE_BUSY_TIMEOUT_MS=

# --- Provider keys (only needed when AI_PROVIDER is not "mock") ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
