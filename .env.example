# Copy to .env and fill in. .env is gitignored, never commit it.

# ===========================================================================
# WHICH DOCKER SHAPE `docker compose up` STARTS
# ===========================================================================
#
# `docker-compose.yml` holds TWO shapes, and the line below chooses which one a bare
# `docker compose up` starts. This file is the only place it is set, because Compose reads
# it from the environment beside the compose file.
#
#   COMPOSE_PROFILES=local      Caddy on 8443, self-signed HTTPS, https://localhost:8443
#                               THE LOCAL CONSOLE. Nothing else needs to exist first.
#
#   docker compose --profile proxy up
#                               The application itself on host port 3000, NO Caddy, for
#                               when something else terminated the TLS. That is the shape for
#                               a VPS behind nginx, and for this machine's live instance,
#                               where the terminator is `tailscale serve`. The profile is
#                               named for what the SHAPE is, not for any one terminator.
#                               (`--profile tailscale` still works as an alias.)
#
# DO NOT DELETE THIS LINE. Both shapes sit behind a profile so that neither drags the other
# along, which means a bare `docker compose up` starts NOTHING without it. Measured, that is
# what happens: the command succeeds and no container exists.
#
# Switching shapes: `docker compose --profile local down` first, then bring the other up.
COMPOSE_PROFILES=local

# Which AI provider to use. One of: mock | gemini | deepseek
#
# "mock" NEEDS NO KEY AND CANNOT RUN A REAL INTERVIEW. It answers every turn with a fixed
# interview question, so it exercises the whole flow - the transport, the guardrails, the
# scoring, the console - without calling anything. That is what makes it the right default
# for tests and for a demo-only instance.
#
# A LIVE RUN NEEDS A REAL PROVIDER AND ITS KEY. Anyone who signs up to be interviewed is
# answered by this setting, so leaving it on "mock" gives them a questionnaire that asks
# questions and never listens. Set AI_PROVIDER to gemini or deepseek and set that provider's
# key (see the AI section below).
AI_PROVIDER=mock

# Hosts this instance answers on, as a comma-separated list. Compare is on the
# hostname only (the port is stripped), case-insensitively, and empty entries
# are ignored, so a trailing comma is harmless.
#
# The intended deployment sets the subdomain; the local development entry lets
# the same .env serve both:
#   ALLOWED_HOST=localhost,127.0.0.1,forgeright.bunkens.be
#
# When the app is reached over Tailscale, the machine's own MagicDNS name must be
# listed too, because the browser sends that as the Host header:
#   ALLOWED_HOST=localhost,127.0.0.1,pi-agents.tail399956.ts.net,forgeright.bunkens.be
#
# THE BEHIND-A-TERMINATOR SHAPE SETS THIS ITSELF, so it works with the variable empty. Its
# compose service sets ALLOWED_HOST to this machine's public hostname plus 127.0.0.1 and
# localhost, because the app refuses a Host it was not told about and the terminator presents
# the public name. Override FORGERIGHT_ALLOWED_HOST in the environment to change it, or set
# this variable if you run the app directly on the host behind a terminator.
#
# Leave empty to accept any host (development only).
# IPv6 literals are not supported here and are refused.
ALLOWED_HOST=

# Port the server listens on. The proxy terminates the subdomain and forwards here.
PORT=3000

# The HOST port the `--profile proxy` shape publishes on, bound to 127.0.0.1. Change it
# if 3000 is taken. `FORGERIGHT_TAILSCALE_PORT` is still read as a fallback, from before
# this variable was renamed.
# FORGERIGHT_PROXY_PORT=3000

# Interface the listener binds. Defaults to 127.0.0.1, so the app is reachable only
# from this host. That is the other half of the proxy-trust boundary: TRUST_PROXY
# decides which PEER may claim a request was HTTPS, and HOST decides who can
# connect at all. Set HOST=0.0.0.0 only when something off-host must connect
# (a proxy on another machine, a private network), and then set TRUST_PROXY to
# that proxy's address.
HOST=127.0.0.1

# Which peers may be trusted to send X-Forwarded-Proto, and therefore to decide
# whether a request counts as secure. The whole site refuses a plain-HTTP request,
# so this setting decides whether anything is served at all behind a proxy.
#
# AN ADDRESS, NOT A HOP COUNT. A hop count says "trust whoever connects to me",
# which a LAN client satisfies just as easily as a proxy: it only has to send the
# header. An address says "trust this peer", which a client cannot claim.
#
#   (unset)        trust nothing. Correct when nothing is in front.
#   127.0.0.1      trust a proxy on this host. THE DEPLOYMENT SETTING for a proxy
#                  running on the same machine, with HOST at its default of
#                  127.0.0.1 so nothing else can reach the port.
#   loopback       alias for 127.0.0.1 and ::1.
#   uniquelocal    trust any peer in a PRIVATE RANGE (RFC 1918: 10.x, 172.16-31.x,
#                  192.168.x). This is the setting for a proxy in ANOTHER CONTAINER,
#                  whose address you either do not know or will not stay fixed.
#                  It is wider than one address, so prefer a named address once you
#                  know it; it is still narrower than trusting everyone.
#   10.0.0.1,10.0.0.2
#                  a list, for a proxy that may appear from more than one address.
#   ::ffff:10.0.0.9
#                  an IPv4-mapped address, which is the form Node reports for a
#                  4-in-6 peer.
#   1              a hop count. Kept because Express supports it, but ONLY safe
#                  when the port is unreachable except through the proxy, because
#                  it cannot tell a proxy from a client. The server warns when
#                  this form is used.
#
# `true` is refused: it trusts EVERY client, which lets any request claim to be
# secure. The server stops at startup rather than accepting it. So does a hostname
# - these are addresses, and `TRUST_PROXY=nginx` is not understood.
TRUST_PROXY=127.0.0.1

# WHO MAY RUN THE QUESTIONNAIRE: an invitation, and nothing else.
#
# There is no shared code and no tokenless way in. To answer the questionnaire a
# person needs an INVITATION TOKEN: an unguessable, single-purpose value mailed to
# them, which identifies both the person and the organisation they belong to. Without
# one, /api/chat and /api/score refuse the request.
#
# AN AUDIT_ACCESS_CODE VARIABLE USED TO BE SET HERE, gating a tokenless visit. It has
# been removed, together with the field that asked for it and the boot warning about
# it. It sat outside this application's security model rather than beside it: an
# organisation is created for a sign-up, people are invited, and every credential
# names somebody. A secret that anyone in the world could hold, that identified nobody
# and belonged to no organisation, could not be reconciled with that.
#
# So there is nothing to configure here. To try the questionnaire on a fresh install,
# invite an address you control from the console and read the link out of the log
# (see MAIL_SENDER below). To look at the product without answering anything, use the
# read-only demo link instead, which needs no invitation.

# --- Admin sign-in ---

# Signs the admin session cookie. REQUIRED: the server refuses to start without
# it, because a secret generated per process would invalidate every session on
# restart and look like a broken login rather than a missing setting.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL for this installation: the absolute address it is reached at.
# Used to build mailed sign-in links AND to redirect a plain-HTTP request to its
# HTTPS address.
#
# Must be set for anything but local development: a URL built from a request
# header would let a forged Host decide where a link or a redirect points. Include
# the base path when there is one. No trailing slash.
# Local:    http://localhost:3000
# Deployed: https://forgeright.bunkens.be
#
# Use https:// here in any deployment. A plain-http value still works over
# localhost, but a remote plain-HTTP request is refused with an explanation rather
# than a redirect, because there is no secure address to send it to.
PUBLIC_BASE_URL=

# Path this app is MOUNTED at: the prefix an incoming request carries, which
# Express strips before the routes run. Empty means the app expects requests at
# the root.
#
# THERE ARE TWO PREFIXES, and a reverse proxy can separate them. The prefix a
# request arrives with may differ from the prefix the browser uses. The second is
# the PUBLIC path: it is derived from the path in PUBLIC_BASE_URL, so it needs no
# variable of its own. All three modes:
#
#   proxy passes the prefix through   BASE_PATH=/forgeright   PUBLIC_BASE_URL=https://host/forgeright
#   proxy STRIPS the prefix           BASE_PATH=               PUBLIC_BASE_URL=https://host/forgeright
#   no prefix at all                  BASE_PATH=               PUBLIC_BASE_URL=https://host
#
# The middle one is `tailscale serve --set-path /forgeright`: it strips
# /forgeright before forwarding, so the app must expect the root while its
# emitted URLs still carry /forgeright. Setting BASE_PATH=/forgeright there
# produces a 404, because the app waits for a prefix it is never sent.
#
# Accepts "forgeright" or "/forgeright"; a trailing slash is ignored. Anything
# that is not a single safe path (a ".." segment, a space, a query or fragment)
# stops the server at startup rather than producing broken URLs.
BASE_PATH=

# OPTIONAL override for the public path, which is otherwise derived from
# PUBLIC_BASE_URL. Set it only when the emitted prefix must differ from that
# URL's path; it is validated and cross-checked against the derived value, and
# startup fails if the two disagree. Leave it empty normally.
PUBLIC_PATH=

# How long a sign-in link stays valid, in minutes. Default 15. Empty counts as
# unset. A link is single-use regardless of this value.
LOGIN_LINK_TTL_MINUTES=

# How long an admin session lasts, in hours. Default 12, which covers a working
# day and ends before the next morning. Empty counts as unset.
SESSION_TTL_HOURS=

# --- Mail ---

# How sign-in links are delivered. One of: console | proton
#   console (default) prints the message to stdout. Needs no credentials, and is
#           how local development works without a mail account.
#   proton  sends through proton-cli on this machine, using the profile below.
#
# With proton: "jobsearch" sends from beard_jobagent@proton.me, a disposable
# mailbox for testing. Production sends from a bunkens.be address, so the profile
# changes there, along with the address it sends as.
MAIL_SENDER=console

# The proton-cli profile to send from, when MAIL_SENDER=proton. A profile with an
# expired session makes the send fail loudly, naming the exit code and the
# command to re-authenticate: proton-cli account login --profile <name>
MAIL_PROTON_PROFILE=jobsearch

# --- Storage ---

# Directory holding one SQLite file per organisation, under <STORE_DIR>/orgs/.
# Defaults to data/store when unset. Point this at a mounted volume in
# production, so the store survives a container rebuild.
STORE_DIR=

# How long a connection waits for another writer's lock, in milliseconds.
# Defaults to 2000 when unset or empty. WAL allows one writer at a time and does
# not queue them, so this is what stops a second participant submitting at the
# same moment from getting a "database is locked" error. Values above 60000 are
# clamped to 60000 with a warning. Leave it empty to take the default; do not set
# it to 0, which disables waiting.
STORE_BUSY_TIMEOUT_MS=

# --- Provider keys (only needed when AI_PROVIDER is not "mock") ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- The read-only demo link (optional; OFF unless DEMO_LOGIN=1) ---
#
# A long-lived link that shows ONE organisation and can change nothing. It is for
# sending to a prospective client, so treat it as untrusted: it is reusable by
# design (that is the point of a link that works for weeks) and it cannot write.
#
# THE ROUTE IS NOT REGISTERED WITHOUT DEMO_LOGIN=1. Not a flag check inside a
# handler: the path `/admin/demo` is never added to the router, so an unconfigured
# deployment answers it with the ordinary 404 for an unknown path.
#
# DEMO_LOGIN_ORG IS READ FROM CONFIGURATION AND NEVER FROM THE REQUEST. That is
# this codebase's central invariant: no route takes a tenant from the request. An
# org id in a URL would be the one mistake that shows one client another's data.
# Find the id in the console, or from the store directory's file name.
#
# IT IS PINNED WHEN A LINK IS USED, SO ROTATING IT DOES NOT MOVE EXISTING SESSIONS.
# The organisation is copied into the session's row at login, so a cookie issued
# against one org keeps showing that org; only links opened afterwards see the new
# value. Re-issue the link if you need an existing viewer moved, and note that the
# pinned session stays read-only either way.
#
# DEMO_LOGIN_TOKEN must be at least 24 characters; 32 random bytes in base64url is
# what the sign-in links use and what this expects. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# The token is compared in constant time, is never logged and is NOT stored in the
# database, so a database read does not hand over the link that leaves the building.
# Rotating it invalidates every link previously sent.
#
# THE TOKEN SHIPPED IN docker-compose.yml IS A PLACEHOLDER, and the app REFUSES it when
# PUBLIC_BASE_URL names anything other than this machine. That is deliberate: a value in a
# public repository is not a credential, and a demo link is a way in. Locally the
# placeholder is fine; on a real hostname the app declines to register the demo route and
# says so in the log. Generate a real one here before deploying.
DEMO_LOGIN=
DEMO_LOGIN_ORG=
DEMO_LOGIN_TOKEN=

# How long a demo link stays valid, in days. Defaults to 60 when unset or empty.
# Empty is how a variable is disabled in a .env file, so it counts as unset; do not
# set it to 0, which would issue links that are dead on arrival.
DEMO_LOGIN_DAYS=
